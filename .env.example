# =============================================================================
# Meridian (Simulated Bank) — example environment configuration
# =============================================================================
# This is a SIMULATION. None of these values connect to real banking, payment,
# SMS, or email systems, and there are NO secrets here (or anywhere in the repo).
# Copy this file to `.env` and adjust if needed.
#
#   PowerShell:  Copy-Item .env.example .env
#   bash/WSL:    cp .env.example .env
#
# Most local development works with the defaults below and does not require
# a `.env` file at all. See docs/PUBLIC_DEMO_DEPLOYMENT.md for the public-demo
# deployment contract.
# =============================================================================

# ---- Backend: deployment posture -------------------------------------------
# Node environment: development | test | production.
#   production → cookies are set with the `Secure` attribute (HTTPS only).
NODE_ENV=development

# SHARED, DISPOSABLE PUBLIC DEMO mode (explicit, opt-in; NOT inferred from NODE_ENV).
#   true → shared-demo warning in both apps, no real visitor IP / user-agent
#          persisted, seeded showcase accounts exempt from lockout, in-memory
#          rate limits on, X-Robots-Tag on API responses.
# Leave false/unset for local development.
PUBLIC_DEMO=false

# Optional overrides (normally unset):
#   COOKIE_SECURE=true|false  force the cookie `Secure` attribute regardless of NODE_ENV
#   RATE_LIMITS=true          turn the abuse limits on outside public-demo mode (local testing)
# COOKIE_SECURE=
# RATE_LIMITS=

# ---- Backend: network -------------------------------------------------------
# Port + bind address of the Fastify API + Socket.IO server.
# Local default: 3000 on 127.0.0.1. The public demo binds loopback only,
# behind a same-origin reverse proxy, on 8102 (set here — never hard-coded).
PORT=3000
HOST=127.0.0.1

# Comma-separated list of allowed browser origins for CORS.
#   local:  http://localhost:5173,http://localhost:5174
#   public: https://banking.cowhill.dev,https://banking-ops.cowhill.dev
CORS_ORIGINS="http://localhost:5173,http://localhost:5174"

# Origins that belong to the OPERATIONS console (fallback signal for picking the
# per-surface session cookie; the apps also send an explicit x-meridian-surface header).
#   local:  http://localhost:5174     public: https://banking-ops.cowhill.dev
OPERATIONS_ORIGINS="http://localhost:5174"

# ---- Backend: database ------------------------------------------------------
# Prisma / SQLite database location. A RELATIVE file: URL is resolved relative to
# apps/backend/prisma (so the default lands at apps/backend/prisma/dev.db).
# A deployment should use an ABSOLUTE file: URL OUTSIDE the release directory,
# e.g. DATABASE_URL="file:/srv/apps/meridian/data/meridian.db". Holds only fake
# demo data; the whole file is the unit of reset (npm run db:baseline builds one).
DATABASE_URL="file:./dev.db"

# Pin the seed instant (ISO-8601) for a deterministic seed / baseline build.
# Unset → the seed uses the wall clock.
# SEED_NOW=2026-09-01T00:00:00Z

# ---- Frontend apps (Vite; build-time) --------------------------------------
# Vite only exposes variables prefixed with VITE_ to client code.
#
# API / Socket.IO base URL. Leave BOTH unset for the normal cases:
#   dev build  → http://localhost:3000
#   production build → the page's own origin (same-origin reverse proxy;
#                      e.g. https://banking.cowhill.dev/api/..., /socket.io)
# Set them only to point a build somewhere else explicitly.
# VITE_API_URL="http://localhost:3000"
# VITE_WS_URL="http://localhost:3000"

# Show the shared-public-demo warning from the first paint (the apps also read
# the backend's /status → publicDemo, so this is belt-and-braces).
VITE_PUBLIC_DEMO=false
